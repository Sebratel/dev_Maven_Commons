<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.com.sebratel</groupId>
        <artifactId>sebratel-java-parent</artifactId>
        <version>1.0.0</version>
        <relativePath/>
    </parent>
    <artifactId>commons-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>commons-parent</name>
    <description>Bibliotecas compartilhadas dos serviços Sebratel (envelope de erro, JWT, cliente Elleven)</description>

    <!--
      O sebratel-java-parent e o sebratel-build-rules (plugin do Checkstyle) vem do GitHub Packages (o Maven exige token `read:packages` até para pacotes públicos).
      Exige <server><id>github</id> no ~/.m2/settings.xml com token read:packages. Ver README.
    -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/Sebratel/dev_Maven_JavaParent</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>github</id>
            <url>https://maven.pkg.github.com/Sebratel/dev_Maven_JavaParent</url>
        </pluginRepository>
    </pluginRepositories>

    <modules>
        <module>common-web</module>
        <module>common-security</module>
        <module>common-elleven</module>
    </modules>

    <!-- Publica neste repositorio, e nao no dev_Maven_JavaParent (que o sebratel-java-parent aponta por padrao). -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - Sebratel</name>
            <url>https://maven.pkg.github.com/Sebratel/dev_Maven_Commons</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages - Sebratel</name>
            <url>https://maven.pkg.github.com/Sebratel/dev_Maven_Commons</url>
        </snapshotRepository>
    </distributionManagement>
</project>
